// Better Auth models (User, Session, Account, Verification) come from
// `npx auth generate`; Meeting and its children are ours.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Triage state for a proposed action item.
enum ActionItemStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

/// Pipeline stages, in order. The UI renders them as a checklist, so the
/// order here is the order shown.
enum MeetingStatus {
  UPLOADED
  TRANSCRIBING
  SUMMARIZING
  VALIDATING
  READY
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  meetings      Meeting[]
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Meeting {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  status      MeetingStatus @default(UPLOADED)

  // Vercel Blob. pathname is kept so the object can be deleted later.
  audioUrl     String?
  blobPathname String?
  sizeBytes    Int?
  contentType  String?
  durationSec  Int?

  // Deepgram. The raw payload lands here from the webhook, then the pipeline
  // maps it; keeping it off the Inngest event avoids the event size limit.
  transcriptionRequestId String?
  transcriptRaw          Json?

  // The summary's own prose. Points and action items hang off it.
  summaryHeadline String?
  summaryOverview String?

  /// Citations the validator could not point at a real segment.
  droppedCitations Int @default(0)

  /// Set together when status is FAILED, and cleared on a retry.
  failureStage  String?
  failureReason String?
  retryCount    Int     @default(0)

  processingStartedAt DateTime?
  readyAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  segments    TranscriptSegment[]
  points      SummaryPoint[]
  actionItems ActionItem[]
  speakers    Speaker[]

  @@index([userId, createdAt])
  @@index([transcriptionRequestId])
}

/// One diarized voice in a meeting, so a rename is a single row rather than an
/// update across every segment — and the original label survives it, which is
/// what keeps the colour stable.
model Speaker {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// The provider's label, e.g. "Speaker 1". Matches TranscriptSegment.speaker.
  key String
  /// What the user renamed it to. Null means show the key.
  label String?

  /// 0-based, assigned in first-appearance order. Picks the colour.
  order Int

  @@unique([meetingId, key])
  @@index([meetingId])
}

model TranscriptSegment {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// 0-based position. This is what the model cites, so it must be stable.
  index   Int
  speaker String?
  text    String
  startMs Int
  endMs   Int

  citedBy       SummaryPoint[]
  citedByAction ActionItem[]

  @@unique([meetingId, index])
  @@index([meetingId, startMs])
}

/// A takeaway, with the transcript moment it came from.
model SummaryPoint {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text      String
  position  Int

  /// Null when the validator dropped an unusable citation but kept the point.
  segmentId String?
  segment   TranscriptSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([segmentId])
}

model ActionItem {
  id        String    @id @default(cuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text      String
  assignee  String?
  dueDate   DateTime?
  position  Int       @default(0)

  status      ActionItemStatus @default(PROPOSED)
  dismissedAt DateTime?
  /// Set when a person edits the text, so the UI can say it was changed.
  editedAt DateTime?

  segmentId String?
  segment   TranscriptSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([segmentId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
