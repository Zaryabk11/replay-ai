# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres: pooled URL for the app, direct URL for Prisma migrations
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared demo account. Nothing in the UI signs into it — these exist so
# `npm run seed:demo` can create/update the account and its placeholder
# meetings, and so that account keeps the tighter upload budget.
# Server-only: never prefix these with NEXT_PUBLIC_.
DEMO_EMAIL=
DEMO_PASSWORD=

# Transcription: Deepgram (speaker diarization)
DEEPGRAM_API_KEY=
# Optional. Defaults to nova-3.
DEEPGRAM_MODEL=
# "callback" (default) posts results to /api/webhooks/deepgram, which needs a
# publicly reachable URL. Set "sync" for local testing with a short clip.
DEEPGRAM_MODE=
# Shared secret on the callback URL. Generate: openssl rand -hex 32
DEEPGRAM_WEBHOOK_SECRET=
# Only when the callback host differs from NEXT_PUBLIC_APP_URL, e.g. a tunnel.
DEEPGRAM_CALLBACK_URL=

# Summaries: Gemini 2.5 Flash (behind the provider interface)
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Inngest. `npx inngest-cli dev` discovers the app automatically; set
# INNGEST_DEV=1 only when running a production build against the dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
