# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres: pooled URL for the app, direct URL for Prisma migrations
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared demo account used by the "Try the demo" button. This is a real user
# row — Better Auth checks the password against the database — so
# `npm run seed:demo` must be run against whichever database the app uses.
# Server-only: never prefix these with NEXT_PUBLIC_.
DEMO_EMAIL=
DEMO_PASSWORD=
# Optional. A playable recording for the seeded demo meetings, e.g. a Blob
# URL. Their transcript timings are synthetic, so a clip only lines up by
# coincidence — it is there to show the player, not to match the words.
# Left empty, the demo still works: citations seek and scroll the transcript,
# and the player shows "Recording unavailable".
DEMO_AUDIO_URL=

# Transcription: Deepgram (speaker diarization)
DEEPGRAM_API_KEY=
# Optional. Defaults to nova-3.
DEEPGRAM_MODEL=
# "callback" (default) posts results to /api/webhooks/deepgram, which needs a
# publicly reachable URL. Set "sync" for local testing with a short clip.
DEEPGRAM_MODE=
# Shared secret on the callback URL. Generate: openssl rand -hex 32
DEEPGRAM_WEBHOOK_SECRET=
# Only when the callback host differs from NEXT_PUBLIC_APP_URL, e.g. a tunnel.
DEEPGRAM_CALLBACK_URL=

# Summaries: Gemini Flash-Lite (behind the provider interface)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite — deliberately the lite line,
# since the flagship gemini-3.8-flash's free tier caps out at 20 requests/day.
GEMINI_MODEL=

# Inngest. `npx inngest-cli dev` discovers the app automatically; set
# INNGEST_DEV=1 only when running a production build against the dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
