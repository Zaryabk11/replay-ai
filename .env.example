# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres: pooled URL for the app, direct URL for Prisma migrations
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared demo account used by the "Try the demo" button.
# Server-only: never prefix these with NEXT_PUBLIC_.
# `npm run seed:demo` creates or updates this account.
DEMO_EMAIL=
DEMO_PASSWORD=

# Transcription: Deepgram (speaker diarization)
DEEPGRAM_API_KEY=

# Summaries: Gemini 2.5 Flash (behind the provider interface)
GEMINI_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
